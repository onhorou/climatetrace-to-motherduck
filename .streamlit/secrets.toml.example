# Template for the dashboard secrets.
#
# Streamlit Community Cloud: App -> Settings -> Secrets -> paste the same TOML.
# Local development:        cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#                           (.streamlit/secrets.toml is gitignored and must never be committed)

# Read/write token of the account that hosts the marts: https://app.motherduck.com/settings/tokens
MOTHERDUCK_TOKEN = "eyJhbGciOiJ...replace-with-your-token"
# Database and schema filled by `poetry run run-etl`.
MOTHERDUCK_DATABASE = "emissions_db"
MOTHERDUCK_SCHEMA = "main"
# single -> one-off session that leaves the saved MotherDuck workspace untouched;
# workspace -> reuse the databases attached in the MotherDuck UI;
# default -> do not send the parameter at all.
MOTHERDUCK_ATTACH_MODE = "single"

# Optional: render a local DuckDB snapshot instead of MotherDuck (handy for trying out the
# dashboard without burning cloud credits). Takes precedence over MOTHERDUCK_TOKEN.
# DASHBOARD_DUCKDB_PATH = "data/emissions.duckdb"
