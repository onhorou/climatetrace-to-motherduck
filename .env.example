# ---------------------------------------------------------------------------
# Climate TRACE -> MotherDuck pipeline configuration.
#
# Usage:  cp .env.example .env  &&  edit .env
# Every variable is optional; the defaults below are the ones baked into
# src/climate_trace_etl/config.py. Empty values are ignored (defaults apply).
# ---------------------------------------------------------------------------

# --- MotherDuck (DuckDB Cloud) ---------------------------------------------
# Read/write token: https://app.motherduck.com/settings/tokens
# Needed only when loading data (the transformer/tests run without it).
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=emissions_db
MOTHERDUCK_SCHEMA=main

# --- Climate TRACE API v7 ---------------------------------------------------
# API v7 exposes /sources (assets) and /owners; there is no /v7/assets route.
CLIMATE_TRACE_API_URL=https://api.climatetrace.org/v7
FETCH_LIMIT=500
# Facilities enriched with /sources/:id ownership details (one request per facility).
MAX_ENRICH_RECORDS=500
# Worker threads used to enrich facilities concurrently (1 = sequential).
ENRICH_WORKERS=8
EMISSIONS_GAS=co2e_100yr
# Leave empty to let the API return its latest reporting year.
EMISSIONS_YEAR=

# --- HTTP resilience --------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=5
RETRY_BACKOFF_SECONDS=1

# --- Runtime / logging ------------------------------------------------------
# local | ci | prod
ENVIRONMENT=local
# TRACE | DEBUG | INFO | SUCCESS | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# true -> one JSON object per log line (recommended in CI).
LOG_JSON=false
